{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/admin",
      "destination": "/admin/login",
      "statusCode": 308,
      "regex": "^(?!/_next)/admin(?:/)?$"
    },
    {
      "source": "/login",
      "destination": "/admin/login",
      "statusCode": 308,
      "regex": "^(?!/_next)/login(?:/)?$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/articles/[id]",
      "regex": "^/api/articles/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/articles/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/artikel/[slug]",
      "regex": "^/artikel/([^/]+?)(?:/)?$",
      "routeKeys": {
